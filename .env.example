# Port the Express server (and, in production, the built frontend it also
# serves -- see DEPLOYMENT.md) listens on.
PORT=4000

# Optional. Root directory for exports, downloaded/generated caches, and
# uploads (everything except the image-bundled fonts, which always live
# with the code). Defaults to the server/ folder itself when unset -- fine
# for local dev, but means a redeploy/restart wipes that state. Point this
# at a mounted persistent disk in production (e.g. /data) to survive
# restarts. See DEPLOYMENT.md and server/src/lib/paths.js.
DATA_DIR=

# Required only for AI-generated background video (POST
# /api/uploads/background-video/generate). Get a key at
# https://dev.runwayml.com -- without this set, that one endpoint returns a
# clear error and everything else in the app is unaffected.
RUNWAYML_API_SECRET=
