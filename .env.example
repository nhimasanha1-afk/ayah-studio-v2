# Port the Express server (and, in production, the built frontend it also
# serves -- see DEPLOYMENT.md) listens on.
PORT=4000

# Required only for AI-generated background video (POST
# /api/uploads/background-video/generate). Get a key at
# https://dev.runwayml.com -- without this set, that one endpoint returns a
# clear error and everything else in the app is unaffected.
RUNWAYML_API_SECRET=
